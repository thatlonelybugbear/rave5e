{
  "name": "Increase template size",
  "_id": "rv5etemplatesize",
  "img": "icons/magic/symbols/runes-star-pentagon-blue.webp",
  "type": "base",
  "system": {
    "changes": [
      {
        "key": "flags.rave5e.changes.0",
        "type": "custom",
        "value": {
          "op": "override",
          "value": "@scaling * @gridDistance",
          "when": {
            "all": [
              {
                "path": "activity.target.template.type",
                "eq": "sphere"
              },
              {
