<section class="rave5e-links-menu-body">
  <div class="rave5e-links-group">
    <div class="rave5e-links-menu-label">
      {{localize "RAVE5E.LinksMenu.GitHubMessage"}}
    </div>
    <div class="rave5e-links-row rave5e-links-row-primary">
      {{#each primaryLinks}}
        <button type="button" class="rave5e-links-menu-button" data-action="openLink" data-url="{{url}}">
          <i class="{{icon}}" inert></i>
          <span>{{label}}</span>
        </button>
      {{/each}}
    </div>
  </div>

  <div class="rave5e-links-row rave5e-links-row-combined">
    <div class="rave5e-links-group">
      <div class="rave5e-links-menu-label">
        {{localize "RAVE5E.LinksMenu.DiscordMessage"}}
      </div>
      <div class="rave5e-links-row rave5e-links-row-secondary">
        {{#each secondaryLinks}}
          <button type="button" class="rave5e-links-menu-button" data-action="openLink" data-url="{{url}}">
            <i class="{{icon}}" inert></i>
            <span>{{label}}</span>
          </button>
        {{/each}}
      </div>
    </div>
    <div class="rave5e-links-group">
      <div class="rave5e-links-menu-label">
        {{localize "RAVE5E.LinksMenu.SupportMessage"}}
      </div>
      <div class="rave5e-links-row rave5e-links-row-tertiary">
        {{#each tertiaryLinks}}
          <button type="button" class="rave5e-links-menu-button" data-action="openLink" data-url="{{url}}">
            <i class="{{icon}}" inert></i>
            <span>{{label}}</span>
          </button>
        {{/each}}
      </div>
    </div>
  </div>
</section>
